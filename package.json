{
  "name": "ekonobar-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @ekonobar/web",
    "start": "npm run start --workspace @ekonobar/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "npm run test --workspace @ekonobar/web",
    "test:unit": "npm run test:unit --workspace @ekonobar/web",
    "test:integration": "npm run test:integration --workspace @ekonobar/web",
    "test:watch": "npm run test:watch --workspace @ekonobar/web",
    "test:e2e": "npm run test:e2e --workspace @ekonobar/web",
    "check:observability": "npm run check:observability --workspace @ekonobar/web",
    "vercel-build": "npm run vercel-build --workspace @ekonobar/web",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed-demo.ts"
  },
  "devDependencies": {
    "prisma": "^6.7.0",
    "tsx": "^4.19.3",
    "turbo": "^2.5.8",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.4.1",
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }
}
